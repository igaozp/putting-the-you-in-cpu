---
import type { Locale } from '../i18n/ui'
import { t } from '../i18n/ui'
import { getChapters, chapterHref, homeHref } from '../i18n/utils'

export interface Props {
	locale: Locale
	chapterSlug: string
}

const { locale, chapterSlug } = Astro.props
const strings = t(locale)
const allChapters = await getChapters(locale)
---

<details class='old-nav'>
	<summary>{strings.allChapters}</summary>

	<ol start='0'>
		<li>
			<a href={homeHref(locale)}>{strings.intro}</a>
		</li>
		{allChapters
			.filter(chapter => chapter.data.chapter !== 0) // Skip the intro
			.map(otherChapter => (
				<li class={otherChapter.data.slug === chapterSlug ? 'active' : ''}>
					<a
						href={chapterHref(locale, otherChapter.data.slug, otherChapter.data.chapter)}
						aria-current={otherChapter.data.slug === chapterSlug ? 'page' : undefined}
					>
						{otherChapter.data.title}
					</a>
				</li>
			))
		}
	</ol>
</details>
