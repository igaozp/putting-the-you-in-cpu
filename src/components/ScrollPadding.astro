---
import type { Locale } from '../i18n/ui'
import { t } from '../i18n/ui'
import { homeHref, onePagerHref } from '../i18n/utils'

export interface Props {
	locale?: Locale
	hideEditions?: boolean
}

const { locale = 'en', hideEditions } = Astro.props
const strings = t(locale)
---

<footer class='scroll-padding'>
	<div class='content'>
		<p>{strings.scrollPaddingBlank}</p>
		<p>{strings.scrollPaddingNote}</p>
		<p>
			<a target='_blank' href={`https://github.com/hackclub/putting-the-you-in-cpu/tree/main/src/content/chapters/${locale}`}>
				{strings.openSource}
			</a>
		</p>
		{hideEditions ? null : <>
			<hr />
			<p>
				{strings.otherEditions}:
				<a href={onePagerHref(locale)}>{strings.onePager}</a> &middot;
				<a href='/editions/printable.pdf'>{strings.pdf}</a>
			</p>
		</>}
	</div>
</footer>
