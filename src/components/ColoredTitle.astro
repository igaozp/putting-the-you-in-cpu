---
import { type Locale, t } from '../i18n/ui'

export interface Props {
	onDark?: boolean
	locale?: Locale
}

const { onDark, locale = 'en' } = Astro.props
const words = t(locale).articleTitleWords

const onLightColors = [ '#e03131', '#f59f00', '#2f9e44', '#1971c2', '#9c36b5' ]
const onDarkColors = [ '#fa5252', '#fab005', '#40c057', '#228be6', '#be4bdb' ]
---

<span class={`colored-title ${onDark ? 'on-dark' : ''}`}>{
	words.map((word, i) => (
		<>
			{i > 0 ? ' ' : null}
			<span style={`--word-color-light: ${onLightColors[i % onLightColors.length]}; --word-color-dark: ${onDarkColors[i % onDarkColors.length]};`}>
				{word}
			</span>
		</>
	))
}</span>

<style>
	.colored-title span {
		color: var(--word-color-light);
	}

	.colored-title.on-dark span {
		color: var(--word-color-dark);
	}

	@media print {
		.colored-title span,
		.colored-title.on-dark span {
			color: var(--word-color-light);
		}
	}
</style>
