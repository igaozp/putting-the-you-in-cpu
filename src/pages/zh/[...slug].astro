---
import '../../styles/global.css'
import '../../styles/chapter.css'

import { render } from 'astro:content'
import TOCList from '../../components/TOCList.astro'
import SEO from '../../components/SEO.astro'
import ExternalNav from '../../components/ExternalNav.astro'
import ColoredTitle from '../../components/ColoredTitle.astro'
import EditButton from '../../components/EditButton.astro'
import ScrollPadding from '../../components/ScrollPadding.astro'
import OldNav from '../../components/OldNav.astro'
import { t } from '../../i18n/ui'
import {
	getChapters,
	getChapter,
	chapterHref,
	homeHref,
	formatChapterLabel,
	formatContinueLabel
} from '../../i18n/utils'

const locale = 'zh' as const
const strings = t(locale)
const slug = Astro.params.slug as string

const chapter = await getChapter(locale, slug)
if (!chapter) {
	return Astro.redirect('/404')
}
const { Content, headings } = await render(chapter)

const allChapters = await getChapters(locale)
const prevChapter = allChapters
	.find(otherChapter => otherChapter.data.chapter === chapter.data.chapter - 1)
const nextChapter = allChapters
	.find(otherChapter => otherChapter.data.chapter === chapter.data.chapter + 1)

export async function getStaticPaths() {
	const chapters = await getChapters('zh')
	return chapters
		.filter(chapter => chapter.data.chapter !== 0) // Skip the intro
		.map(chapter => ({ params: { slug: chapter.data.slug } }))
}
---

<html lang='zh-CN'>
<head>
	<meta charset='utf-8' />
	<meta name='viewport' content='width=device-width, initial-scale=1' />

	<link rel='preconnect' href='https://fonts.googleapis.com' />
	<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
	<link href='https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=IBM+Plex+Sans:wght@400;700&family=IBM+Plex+Serif:ital,wght@0,400;0,700;1,400;1,700&family=Noto+Serif+SC:wght@400;700&display=swap' rel='stylesheet' />

	<SEO locale={locale} chapterSlug={chapter.data.slug} />
	<script defer data-domain='cpu.land' src='https://plausible.io/js/script.js' />
</head>
<body>
	<ExternalNav locale={locale} currentChapterSlug={chapter.data.slug} />

	<nav class='internal' aria-label={strings.chapterContents}>
		<h2>{strings.chapterContents}</h2>
		
		<TOCList headings={[
			{ depth: 2, text: strings.intro, slug: 'intro' },
			...headings
		]} />

		<div class='navigation'>
			{prevChapter ? (
				<a href={chapterHref(locale, prevChapter.data.slug, prevChapter.data.chapter)}>
					<span aria-hidden='true'>&laquo;</span>
					<span class='sr-only'>{strings.previous}:</span>
					{formatChapterLabel(locale, prevChapter.data.chapter)}
				</a>
			) : null}
			{nextChapter ? (
				<a href={chapterHref(locale, nextChapter.data.slug, nextChapter.data.chapter)}>
					<span class='sr-only'>{strings.next}:</span>
					{formatChapterLabel(locale, nextChapter.data.chapter)}
					<span aria-hidden='true'>&raquo;</span>
				</a>
			) : null}
		</div>
	</nav>

	<main>
		<header class='content'>
			<h1 id='intro'>
				<div class='chapter'>{formatChapterLabel(locale, chapter.data.chapter)}<span class='sr-only'>：</span></div>
				<div class='title'>
					{chapter.data.title}
					<EditButton locale={locale} chapterSlug={chapter.data.slug} />
				</div>
			</h1>
		</header>

		<div class='you-are-here'>
			<div class='content'>
				<p>
					{strings.partOf}{' '}
					<a href={homeHref(locale)} style='--color: transparent;'><ColoredTitle locale={locale} /></a>
					{strings.partOfSuffix}
				</p>
				<OldNav locale={locale} chapterSlug={chapter.data.slug} />
			</div>
		</div>

		<div class='content'>
			<Content />

			{nextChapter ? (
				<a class='continue' href={chapterHref(locale, nextChapter.data.slug, nextChapter.data.chapter)}>
					{formatContinueLabel(locale, nextChapter.data.chapter, nextChapter.data.title)} <span aria-hidden='true'>&raquo;</span>
				</a>
			) : null}
		</div>

		<ScrollPadding locale={locale} />
	</main>

	<script define:vars={{ dev: import.meta.env.DEV }}>
		window.__ASTRO_DEV_MODE__ = dev
	</script>
	<script>
		const scrollRestoreKey = `scroll-restore-${window.location.pathname}`

		// Scrollspy
		const leeway = 80
		const container = document.querySelector('main')
		const headings = [ ...document.querySelectorAll('h1, h2, h3, h4, h5, h6') ]
			.filter(el => !!el.id)
		headings.reverse()

		let current = 'intro'
		const updateScrollspy = () => {
			for (const el of document.querySelectorAll('[data-scrollspy]')) {
				el.classList.toggle('scrollspy-active', el.dataset.scrollspy === current)
			}
		}
		
		container.addEventListener('scroll', () => {
			let next = 'intro'
			for (const heading of headings) {
				if (container.scrollTop >= heading.offsetTop - leeway) {
					next = heading.id
					break
				}
			}
			if (next !== current) {
				current = next
				updateScrollspy()
			}

			if (window.__ASTRO_DEV_MODE__) {
				sessionStorage.setItem(scrollRestoreKey, container.scrollTop.toString())
			}
		}, { passive: true })

		updateScrollspy()

		// Restore scroll for live reloading
		setTimeout(() => {
			if (window.__ASTRO_DEV_MODE__ && sessionStorage.getItem(scrollRestoreKey)) {
				container.scrollTop = parseInt(sessionStorage.getItem(scrollRestoreKey))
			}
		}, 0)
	</script>
</body>
</html>
