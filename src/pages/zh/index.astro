---
import '../../styles/global.css'
import '../../styles/home.css'

import { render } from 'astro:content'
import SEO from '../../components/SEO.astro'
import ColoredTitle from '../../components/ColoredTitle.astro'
import ExternalNav from '../../components/ExternalNav.astro'
import EditButton from '../../components/EditButton.astro'
import ScrollPadding from '../../components/ScrollPadding.astro'
import LanguageSwitcher from '../../components/LanguageSwitcher.astro'
import { t } from '../../i18n/ui'
import { getChapter, chapterHref, formatContinueLabel } from '../../i18n/utils'

const locale = 'zh' as const
const strings = t(locale)
const intro = await getChapter(locale, 'intro')
const chapterOne = await getChapter(locale, 'the-basics')
const { Content: Intro } = await render(intro!)
---

<html lang='zh-CN'>
<head>
	<meta charset='utf-8' />
	<meta name='viewport' content='width=device-width, initial-scale=1' />

	<link rel='preconnect' href='https://fonts.googleapis.com' />
	<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
	<link href='https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,700;1,400&family=Noto+Serif+SC:wght@400;700&display=swap' rel='stylesheet' />

	<SEO locale={locale} chapterSlug='intro' />
	<script defer data-domain='cpu.land' src='https://plausible.io/js/script.js' />
</head>
<body>
	<a class='orpheus-flag' target='_blank' href='https://hackclub.com/'>
		<img src='/orpheus-flag.svg' width='560' height='315' alt='Hack Club 项目' title='Hack Club 项目' />
	</a>

	<header>
		<img src='/squiggles/top.svg' class='squiggles top' alt='' aria-hidden='true' />
		<div class='content'>
			<div class='lang-bar'>
				<LanguageSwitcher locale={locale} chapterSlug='intro' />
			</div>
			<h1><ColoredTitle onDark locale={locale} /></h1>
			<p class='abstract'>{strings.abstract}</p>
			<p>
				{strings.by}
				{' '}
				<a target='_blank' href='https://kognise.dev/'>Lexi Mattick</a>
				&
				<a href='https://hackclub.com/'>Hack Club</a>
				&middot;
				{strings.date}
			</p>
		</div>
		<img src='/squiggles/bottom.svg' class='squiggles bottom' alt='' aria-hidden='true' />
	</header>
	<ExternalNav noScript locale={locale} currentChapterSlug='intro' />

	<main>
		<div class='content'>
			<h2 id='from-the-beginning'>
				{strings.fromTheBeginning}
				<EditButton locale={locale} chapterSlug='intro' />
			</h2>

			<Intro />

			<a class='continue' href={chapterHref(locale, 'the-basics', 1)}>
				{formatContinueLabel(locale, 1, chapterOne!.data.title)}
				<span aria-hidden='true'>&raquo;</span>
			</a>
		</div>

		<ScrollPadding locale={locale} />
	</main>
</body>
</html>

<style>
	.lang-bar {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 0.75rem;
	}

	.lang-bar :global(.lang-switcher) {
		color: rgba(255, 255, 255, 0.85);
	}

	.lang-bar :global(.lang-switcher a) {
		color: inherit;
	}

	.lang-bar :global(.lang-switcher strong) {
		color: #fff;
	}
</style>
