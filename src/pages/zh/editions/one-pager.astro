---
import '../../../styles/global.css'
import '../../../styles/one-pager.css'

import { render } from 'astro:content'
import DowngradeHeadings from '../../../components/DowngradeHeadings.astro'
import ScrollPadding from '../../../components/ScrollPadding.astro'
import ColoredTitle from '../../../components/ColoredTitle.astro'
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro'
import { t } from '../../../i18n/ui'
import { getChapters, homeHref, formatChapterLabel } from '../../../i18n/utils'

const locale = 'zh' as const
const strings = t(locale)
const chapters = await getChapters(locale)
const rendered = await Promise.all(
	chapters.map(async chapter => [ chapter, await render(chapter) ] as const)
)
---

<html lang='zh-CN'>
<head>
	<meta charset='utf-8' />
	<meta name='viewport' content='width=device-width, initial-scale=1' />

	<link rel='preconnect' href='https://fonts.googleapis.com' />
	<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
	<link href='https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=IBM+Plex+Serif:ital,wght@0,400;0,700;1,400;1,700&family=Noto+Serif+SC:wght@400;700&display=swap' rel='stylesheet' />

	<title>{`${strings.onePager} | ${strings.articleTitle}`}</title>
	<meta name='description' content={strings.abstract} />
	<script defer data-domain='cpu.land' src='https://plausible.io/js/script.js' />
</head>
<body>
	<header>
		<div class='content'>
			<div class='lang-bar'>
				<LanguageSwitcher locale={locale} onePager />
			</div>
			<h1><ColoredTitle onDark locale={locale} /></h1>
			<p class='byline'>
				{strings.by}
				{' '}
				<a target='_blank' href='https://kognise.dev/'>Lexi Mattick</a>
				&
				<a href='https://hackclub.com/'>Hack Club</a>
				&middot;
				{strings.date}
			</p>
		</div>
		<div class='editions'>
			<div class='label'>{strings.editions}</div>
			<div>
				<a href={homeHref(locale)}>{strings.normal}</a> &middot;
				<strong>{strings.onePager}</strong> &middot;
				<a href='/editions/printable.pdf'>{strings.pdf}</a>
			</div>
		</div>
		<img src='/squiggles/print.svg' class='cover-bg' />
	</header>

	<main>
		<div class='content'>
			{rendered.map(([ chapter, { Content } ]) => <>
				<h2 id={chapter.data.slug}>{formatChapterLabel(locale, chapter.data.chapter)}：{chapter.data.title}</h2>
				<DowngradeHeadings>
					<Content />
				</DowngradeHeadings>
			</>)}

			<ScrollPadding locale={locale} hideEditions />
		</div>
	</main>
</body>
</html>

<style>
	.lang-bar {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 0.75rem;
	}

	.lang-bar :global(.lang-switcher) {
		color: rgba(255, 255, 255, 0.85);
	}

	.lang-bar :global(.lang-switcher a) {
		color: inherit;
	}

	.lang-bar :global(.lang-switcher strong) {
		color: #fff;
	}
</style>
